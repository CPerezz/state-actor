diff --git a/execution/engineapi/engine_server.go b/execution/engineapi/engine_server.go
index 7bda514025..19c5ac79ac 100644
--- a/execution/engineapi/engine_server.go
+++ b/execution/engineapi/engine_server.go
@@ -740,7 +740,25 @@ func (s *EngineServer) forkchoiceUpdated(ctx context.Context, forkchoiceState *e
 	}
 
 	s.logger.Debug("[ForkChoiceUpdated] processing new request", newReqLogInfoArgs...)
-	status, err := s.getQuickPayloadStatusIfPossible(ctx, forkchoiceState.HeadHash, 0, common.Hash{}, forkchoiceState, false)
+	// [INST-B8] STATE-ACTOR PATCH: skip the quick-FCU optimization when
+	// payloadAttributes != nil. The quick path returns ValidStatus without
+	// calling HandleForkChoice → updateForkChoice → dispatchNotifications →
+	// PublishOverlay(sd). The BUILDER (called via payloadAttributes) then
+	// has sdProvider() returning nil, sd.parent unset, and SeekCommitment
+	// falls through to state-actor's snapshot genesis. With this skip,
+	// HandleForkChoice runs, PublishOverlay(sd) fires, and the BUILDER's
+	// next sdProvider() call returns the post-block-N SD.
+	log.Warn("[INST-B8] forkchoiceUpdated ENTRY",
+		"head", forkchoiceState.HeadHash.Hex(),
+		"hasAttrs", payloadAttributes != nil)
+	var status *engine_types.PayloadStatus
+	var err error
+	if payloadAttributes == nil {
+		status, err = s.getQuickPayloadStatusIfPossible(ctx, forkchoiceState.HeadHash, 0, common.Hash{}, forkchoiceState, false)
+	} else {
+		log.Warn("[INST-B8] BYPASSED getQuickPayloadStatusIfPossible (has attrs)",
+			"head", forkchoiceState.HeadHash.Hex())
+	}
 	if err != nil {
 		return nil, err
 	}
